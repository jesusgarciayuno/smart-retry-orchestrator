		{
			"name": "07 - Full Demo Flow",
			"description": "An end-to-end demonstration sequence that exercises the entire system: health check, bulk data generation, metrics inspection, processor health review, strategy analysis, and data reset. Run these requests in order.",
			"item": [
				{
					"name": "Step 01 - Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						},
						"description": "Step 1: Confirm the service is running before starting the demo flow."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Service is healthy', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('ok');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Step 02 - Generate Test Events",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
