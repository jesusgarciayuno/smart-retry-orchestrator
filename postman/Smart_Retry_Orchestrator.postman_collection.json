	"item": [
		{
			"name": "01 - System Health",
			"description": "Basic liveness and readiness probes for the service.",
			"item": [
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						},
						"description": "Verifies the service is running and healthy. Returns a simple status object. This is the first request you should run to confirm connectivity."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response status is ok', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('ok');",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "02 - Transaction Processing",
			"description": "Submit payment failure events and report retry outcomes. Demonstrates soft-decline vs hard-decline classification and batch ingestion.",
			"item": [
				{
					"name": "Submit Single Failure (Soft Decline - Timeout)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"transaction_id\": \"test-soft-001\",\n\t\"amount\": 150.00,\n\t\"currency\": \"USD\",\n\t\"failure_code\": \"PROCESSOR_TIMEOUT\",\n\t\"processor\": \"PROCESSOR_A\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{api_prefix}}/failures",
							"host": ["{{base_url}}{{api_prefix}}"],
							"path": ["failures"]
						},
						"description": "Submits a processor timeout failure event. Timeouts are classified as soft declines, so the orchestrator should recommend a retry with an optimal strategy."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('should_retry is true for soft decline', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.should_retry).to.eql(true);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Submit Single Failure (Hard Decline - Fraud)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"transaction_id\": \"test-hard-001\",\n\t\"amount\": 200.00,\n\t\"currency\": \"MYR\",\n\t\"failure_code\": \"FRAUD_SUSPECTED\",\n\t\"processor\": \"PROCESSOR_B\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{api_prefix}}/failures",
							"host": ["{{base_url}}{{api_prefix}}"],
							"path": ["failures"]
						},
						"description": "Submits a fraud-suspected failure event. Fraud is a hard decline and must never be retried. The orchestrator should return should_retry as false."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('should_retry is false for hard decline', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.should_retry).to.eql(false);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Submit Single Failure (Soft Decline - Rate Limited)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"transaction_id\": \"test-soft-002\",\n\t\"amount\": 75.50,\n\t\"currency\": \"EUR\",\n\t\"failure_code\": \"RATE_LIMIT_EXCEEDED\",\n\t\"processor\": \"PROCESSOR_C\"\n}"
						},
						"url": {
							"raw": "{{base_url}}{{api_prefix}}/failures",
							"host": ["{{base_url}}{{api_prefix}}"],
							"path": ["failures"]
						},
						"description": "Submits a rate-limit failure event. Rate limiting is a transient (soft) decline. The orchestrator should recommend a retry, typically with a longer backoff interval."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('should_retry is true for rate limit soft decline', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.should_retry).to.eql(true);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Submit Batch Failures",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"events\": [\n\t\t{\n\t\t\t\"transaction_id\": \"batch-001\",\n\t\t\t\"amount\": 50.00,\n\t\t\t\"currency\": \"USD\",\n\t\t\t\"failure_code\": \"PROCESSOR_TIMEOUT\",\n\t\t\t\"processor\": \"PROCESSOR_A\"\n\t\t},\n\t\t{\n\t\t\t\"transaction_id\": \"batch-002\",\n\t\t\t\"amount\": 120.00,\n\t\t\t\"currency\": \"EUR\",\n\t\t\t\"failure_code\": \"INSUFFICIENT_FUNDS\",\n\t\t\t\"processor\": \"PROCESSOR_B\"\n\t\t},\n\t\t{\n\t\t\t\"transaction_id\": \"batch-003\",\n\t\t\t\"amount\": 300.00,\n\t\t\t\"currency\": \"GBP\",\n\t\t\t\"failure_code\": \"FRAUD_SUSPECTED\",\n\t\t\t\"processor\": \"PROCESSOR_C\"\n\t\t},\n\t\t{\n\t\t\t\"transaction_id\": \"batch-004\",\n\t\t\t\"amount\": 85.75,\n\t\t\t\"currency\": \"USD\",\n\t\t\t\"failure_code\": \"RATE_LIMIT_EXCEEDED\",\n\t\t\t\"processor\": \"PROCESSOR_A\"\n\t\t},\n\t\t{\n\t\t\t\"transaction_id\": \"batch-005\",\n\t\t\t\"amount\": 999.99,\n\t\t\t\"currency\": \"PHP\",\n\t\t\t\"failure_code\": \"NETWORK_ERROR\",\n\t\t\t\"processor\": \"PROCESSOR_B\"\n\t\t}\n\t]\n}"
						},
						"url": {
							"raw": "{{base_url}}{{api_prefix}}/failures/batch",
							"host": ["{{base_url}}{{api_prefix}}"],
							"path": ["failures", "batch"]
						},
						"description": "Submits a batch of 5 mixed failure events in a single request. Includes soft declines (timeout, rate-limit, network error, insufficient funds) and a hard decline (fraud). Demonstrates bulk ingestion capability."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Response contains results array', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.results).to.be.an('array');",
									"    pm.expect(jsonData.results.length).to.eql(5);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Report Retry Outcome",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"processor\": \"PROCESSOR_B\",\n\t\"success\": true\n}"
						},
						"url": {
							"raw": "{{base_url}}{{api_prefix}}/retries/test-soft-001/outcome",
							"host": ["{{base_url}}{{api_prefix}}"],
							"path": ["retries", "test-soft-001", "outcome"]
						},
						"description": "Reports that a retry attempt for transaction test-soft-001 succeeded on PROCESSOR_B. This feedback is used by the adaptive strategy engine to update processor reliability scores and routing weights."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Outcome was recorded', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('recorded');",
									"});"
								]
							}
						}
					]
				}
			]
		},
